--TEST--
MustacheAST rejects malformed resource-limit inputs and remains reusable
--SKIPIF--
<?php if (!extension_loaded('mustache')) die('skip '); ?>
--FILE--
<?php
function reportRejectedAST($label, $encoded) {
  try {
    new MustacheAST(base64_decode($encoded, true));
    echo $label, ":accepted\n";
  } catch (MustacheException $e) {
    echo $label, ':', $e->getMessage(), "\n";
  }
}

reportRejectedAST(
  'oversized-child-region',
  'TVUAAQAAAAAAAf////9NVQAQAQAABQAAAAAAAHRlc3QA'
);
reportRejectedAST(
  'deeply-nested',
  ''
);

$mustache = new Mustache();
$ast = new MustacheAST((string) $mustache->parse('Hello {{name}}'));
var_dump($mustache->render($ast, array('name' => 'world')));
?>
--EXPECT--
oversized-child-region:Truncated serial child data
deeply-nested:Serial node nesting limit exceeded
string(11) "Hello world"
